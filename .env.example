# Groq Cloud API Key (Required for Multimodal Vision OCR extraction)
# Sign up and get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Google Gemini API Key (Fallback Vision Provider)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
