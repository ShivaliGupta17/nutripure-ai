# Virtual Environment
venv/
env/
ENV/
.venv/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Environment variables & Secrets (CRITICAL: Do not commit API keys!)
.env
.env.local
*.env

# Runtime Checkpoint & Vector DB
data/*.db
data/*.db-shm
data/*.db-wal
*.sqlite
*.sqlite3
data/chroma_db/

# Temporary User Upload Cache & Logs
data/uploaded_cache/*
!data/uploaded_cache/.gitkeep
.system_generated/
*.log

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
